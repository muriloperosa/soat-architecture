# Copie para secrets.env (ignorado pelo git) e preencha com os valores do
# ambiente AWS:
#   cp k8s/overlays/eks/secrets.env.example k8s/overlays/eks/secrets.env
#
# Senha do usuário do RDS. Use apenas letras e números: o valor entra na URL
# de conexão do Job de migration e @ : / ? # quebram a URL.
DB_PASSWORD=changeme
# Chave HS256 dos tokens JWT. Gere uma com: openssl rand -hex 32
JWT_SECRET=changeme

# E-mail pelo SES. Mantenha log para simular ou use ses para envio real.
EMAIL_PROVIDER=log
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SES_FROM_ADDRESS=

# Links de aprovação do orçamento. Para habilitar, defina ambos o segredo e a
# URL pública. O segredo deve ser diferente de JWT_SECRET.
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_TTL_HOURS=24
PUBLIC_BASE_URL=
