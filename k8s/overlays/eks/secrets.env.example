# Copie para secrets.env (ignorado pelo git) e preencha com os valores do
# ambiente AWS:
#   cp k8s/overlays/eks/secrets.env.example k8s/overlays/eks/secrets.env
#
# Senha do usuário do RDS. Use apenas letras e números: o valor entra na URL
# de conexão do Job de migration e @ : / ? # quebram a URL.
DB_PASSWORD=changeme
# Chave HS256 dos tokens JWT. Gere uma com: openssl rand -hex 32
JWT_SECRET=changeme
# O workflow gera este arquivo no runner. Para SMTP, carrega as variáveis de
# um secret separado no Secrets Manager. Não versione a senha de app.
# Não coloque AWS_ACCESS_KEY_ID aqui: no EKS o pod usa a role do nó.

# Links de aprovação do orçamento. O workflow lê o segredo de aprovação do
# Secrets Manager (oficina/api). A URL vem da Variable PUBLIC_BASE_URL ou,
# sem ela, do hostname do LoadBalancer.
# O segredo deve ser diferente de JWT_SECRET.
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_TTL_HOURS=24
PUBLIC_BASE_URL=
