# Copie para secrets.env (ignorado pelo git) e preencha com os valores do
# ambiente AWS:
#   cp k8s/overlays/eks/secrets.env.example k8s/overlays/eks/secrets.env
#
# Senha do usuário do RDS. Use apenas letras e números: o valor entra na URL
# de conexão do Job de migration e @ : / ? # quebram a URL.
DB_PASSWORD=changeme
# Chave HS256 dos tokens JWT. Gere uma com: openssl rand -hex 32
JWT_SECRET=changeme
