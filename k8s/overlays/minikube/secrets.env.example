# Copie para secrets.env (ignorado pelo git) e troque os valores:
#   cp k8s/overlays/minikube/secrets.env.example k8s/overlays/minikube/secrets.env
#
# DB_PASSWORD vira a senha de root do MySQL e também entra na URL de conexão
# do Job de migration. Use apenas letras e números: @ : / ? # quebram a URL.
DB_PASSWORD=changeme
# Chave HS256 dos tokens JWT. Gere uma com: openssl rand -hex 32
JWT_SECRET=changeme

# E-mail pelo SES. Mantenha log para simular ou use ses para envio real.
EMAIL_PROVIDER=log
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
SES_FROM_ADDRESS=

# Links de aprovação do orçamento. Para habilitar, defina ambos o segredo e a
# URL pública. O segredo deve ser diferente de JWT_SECRET.
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_TTL_HOURS=24
PUBLIC_BASE_URL=
