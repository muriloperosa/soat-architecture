      "name": "21 - Verificar filtro de OS encerradas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/ordens-servico",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "ordens-servico"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const items = pm.response.json().items || [];",
              "const osId = Number(pm.collectionVariables.get('ordem_servico_id'));",
              "const decision = pm.collectionVariables.get('decisao_orcamento');",
              "pm.test('Nenhuma OS encerrada aparece na listagem', () => pm.expect(items.every(item => !['FINALIZADA', 'ENTREGUE'].includes(item.status))).to.be.true);",
              "if (decision === 'aprovar') pm.test('OS entregue foi excluida da listagem', () => pm.expect(items.some(item => item.id === osId)).to.be.false);",
              "else pm.test('OS rejeitada permanece na listagem', () => pm.expect(items.some(item => item.id === osId && item.status === 'REJEITADA')).to.be.true);"
            ]
          }
        }
      ]
