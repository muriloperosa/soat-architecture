              "const items = pm.response.json().items || [];",
              "pm.test('Todos os resultados respeitam status=RECEBIDA', () => pm.expect(items.length).to.be.greaterThan(0) && pm.expect(items.every(item => item.status === 'RECEBIDA')).to.be.true);",
              "pm.test('OS RECEBIDA aparecem da mais antiga para a mais nova', () => { for (let i = 1; i < items.length; i++) { const previous = items[i - 1]; const current = items[i]; const previousTime = Date.parse(previous.data_cadastro); const currentTime = Date.parse(current.data_cadastro); pm.expect(currentTime).to.be.at.least(previousTime); if (currentTime === previousTime) pm.expect(current.id).to.be.at.least(previous.id); } });"
            ]
          }
        }
      ]
