      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Listagem retorna 200', () => pm.response.to.have.status(200));",
              "const items = pm.response.json().items || [];",
              "const osId = Number(pm.collectionVariables.get('ordem_servico_id'));",
              "pm.test('Listagem inclui a OS aberta', () => pm.expect(items.some(item => item.id === osId)).to.be.true);",
              "pm.test('Listagem exclui FINALIZADA e ENTREGUE', () => pm.expect(items.every(item => !['FINALIZADA', 'ENTREGUE'].includes(item.status))).to.be.true);",
              "const order = { EM_EXECUCAO: 0, APROVADA: 1, AGUARDANDO_APROVACAO: 2, REJEITADA: 2, EM_DIAGNOSTICO: 3, RECEBIDA: 4 };",
              "pm.test('Listagem respeita prioridade e idade', () => {",
              "  for (let i = 1; i < items.length; i++) {",
              "    const previous = items[i - 1]; const current = items[i];",
              "    const previousPriority = order[previous.status]; const currentPriority = order[current.status];",
              "    if (previousPriority !== undefined && currentPriority !== undefined) {",
              "      pm.expect(currentPriority).to.be.at.least(previousPriority);",
              "      if (currentPriority === previousPriority) pm.expect(Date.parse(current.data_cadastro)).to.be.at.least(Date.parse(previous.data_cadastro));",
              "    }",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
