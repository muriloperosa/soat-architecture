          "raw": "{\n  \"motivo\": \"Valor acima do esperado - teste da Fase 2\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const expected = pm.collectionVariables.get('decisao_orcamento') === 'rejeitar' ? 'REJEITADA' : 'APROVADA';",
              "pm.test('Decisao retorna 200', () => pm.response.to.have.status(200));",
              "pm.test('Status corresponde a decisao escolhida', () => pm.expect(pm.response.json().status).to.eql(expected));"
            ]
          }
        }
      ]
