# API porta interna (usada pelo config.go / container) e porta exposta no host
APP_PORT=8080
APP_HOST_PORT=8080

# MySQL porta interna (dentro da rede docker) e porta exposta no host
DB_HOST=localhost
DB_PORT=3306
DB_HOST_PORT=3306

# MySQL credenciais (usadas tanto pela API quanto pra criar o usuário/banco no container)
DB_USER=root
DB_PASSWORD=root
DB_NAME=oficina
