# API porta interna (usada pelo config.go / container) e porta exposta no host
APP_PORT=8080
APP_HOST_PORT=8080

# MySQL porta interna (dentro da rede docker) e porta exposta no host
DB_HOST=localhost
DB_PORT=3306
DB_HOST_PORT=3306

# MySQL credenciais (usadas tanto pela API quanto pra criar o usuário/banco no container)
DB_USER=root
DB_PASSWORD=root
DB_NAME=mecanica

# MySQL connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=5

# Database driver
DB_DRIVER=mysql

# JWT (HS256)
JWT_SECRET=changeme
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_HOURS=168

# Token assinado dos links de aprovação de orçamento (segredo separado do JWT).
# Configure um segredo aleatório próprio antes de habilitar esse fluxo.
APPROVAL_TOKEN_SECRET=
APPROVAL_TOKEN_TTL_HOURS=24
# Para habilitar os links, configure também o segredo acima.
PUBLIC_BASE_URL=
# Exemplo local: http://localhost:8080

# E-mail de mudança de status da ordem de serviço.
# log (padrão) só registra a mensagem. ses usa a cadeia de credenciais padrão
# da AWS. Em Docker Compose, informe as credenciais abaixo neste arquivo para
# que o container da API consiga acessá-las. Credenciais temporárias (AWS
# Academy/STS) também exigem AWS_SESSION_TOKEN.
# Com EMAIL_PROVIDER=ses, SES_FROM_ADDRESS é obrigatório. No sandbox do SES,
# remetente e cada destinatário precisam ser identidades verificadas.
EMAIL_PROVIDER=log
AWS_REGION=us-east-1
SES_FROM_ADDRESS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# SonarQube
SONAR_HOST_PORT=9000
SONAR_TOKEN=
SONAR_HOST_URL=http://sonarqube:9000

# ZAP DAST (make sec-dast) portas host da stack isolada (security/compose.dast.yml),
# diferentes de APP_HOST_PORT/DB_HOST_PORT pra não colidir com o ambiente de dev
DAST_APP_HOST_PORT=8081
DAST_DB_HOST_PORT=3307
